# Tubarr configuration. Copy to .env and adjust. Everything here is optional except YOUTUBE_DIR.
# No secrets belong in this file: the admin password, Plex token and proxy credentials are set in the web UI and
# stored hashed (password, API key) or encrypted (Plex token, proxies) under the data folder.

# ---------------------------------------------------------------- folders and user
# Where the videos go, on the host. Point Plex's library at this same folder.
YOUTUBE_DIR=/srv/media/youtube
# Tubarr's own data (database, settings, encrypted credentials, logs). Default: ./data next to docker-compose.yml.
TUBARR_DATA_DIR=./data
# The user/group the container runs as. Both folders above must be writable by it (chown -R 1000:1000 <folder>).
PUID=1000
PGID=1000
# Time zone for upload dates and schedules, e.g. Europe/Berlin, America/Chicago.
TZ=UTC
# Host port for the web UI. docker-compose.yml publishes it on 127.0.0.1 only; see the comment there for LAN access.
# Published Docker ports bypass the host firewall (ufw/firewalld), and 9194 must never be port-forwarded on your
# router: for remote access use a reverse proxy with HTTPS or a VPN.
TUBARR_PORT=9194

# ---------------------------------------------------------------- downloads (all of these can also be changed live
# ---------------------------------------------------------------- in Settings -> Downloads; the page wins)
# Fill target in GB (decimal). Tubarr fills the library up to this, then rolls: newest in, oldest out.
TUBARR_FILL_TARGET_GB=1000
# Best quality: 2160 (4K), 1440, 1080 or 720.
TUBARR_MAX_HEIGHT=2160
# 0 = never download AV1 (plays everywhere, no transcoding); 1 = allow AV1 when it's the best format.
TUBARR_ALLOW_AV1=0
# Pace. Backlog downloads per 24 h (new uploads aren't held by it), and the random pause between downloads.
TUBARR_DAILY_CAP=40
TUBARR_GAP_MIN_MINUTES=10
TUBARR_GAP_MAX_MINUTES=20
# Downloads at once. Keep 1 unless you know your connection won't get flagged (YouTube notices bursts).
TUBARR_CONCURRENCY=1
# Never delete each channel's newest N videos when rolling.
TUBARR_PROTECT_NEWEST=3
# Per-download speed limit in bytes/s (0 = none).
TUBARR_RATELIMIT=0
# How often new uploads are checked (minutes, via each channel's RSS feed).
TUBARR_POLL_MIN=5
# Don't start a download when less than this many GB are free on the library's disk.
TUBARR_MIN_FREE_GB=30

# ---------------------------------------------------------------- Plex (optional; normally set in the first-run setup)
# The Plex token is NEVER set here: use "Sign in with Plex" in the setup, which stores it encrypted.
# PLEX_URL=http://plex.local:32400
# PLEX_SECTION=YouTube
# The media folder as Plex sees it, if Plex's container mounts it at a different path than /youtube.
# PLEX_ROOT=/data/youtube

# ---------------------------------------------------------------- web UI and accounts
# Unattended installs only: seed the admin account from an argon2id HASH (never the password itself). Make one with:
#   docker run --rm -it tubarr:local python -m tubarr.hashpw
# and paste it in single quotes. Leave empty to create the admin in the browser (normal path).
# TUBARR_ADMIN_USER=admin
# TUBARR_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_YOUR_HASH'
# Sign-in lasts this many days.
TUBARR_SESSION_DAYS=30
# Session cookies get the Secure flag automatically over HTTPS (also behind a proxy sending X-Forwarded-Proto).
# Force it with 1, or turn it off with 0.
TUBARR_COOKIE_SECURE=auto
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted: a comma list of IPs or CIDRs,
# e.g. 172.18.0.5 or 10.0.0.0/24. Empty (the default) = trust none, and those headers are ignored. Only list
# proxies you run: anyone else could fake their client address and HTTPS state.
TUBARR_TRUSTED_PROXIES=

# ---------------------------------------------------------------- updates
# The image ships a pinned, hash-verified yt-dlp; update it by pulling a newer Tubarr image (docker compose pull).
# 1 = also fetch the newest yt-dlp release from PyPI at every container start (held in memory under /tmp, never in the
#     data folder) and use it instead. Helps when YouTube changes something before a new image is out, but that code is
#     not hash-pinned or reviewed: you trust PyPI and yt-dlp's release process at each start. Needs PyPI to be
#     reachable; if it isn't, the image's version is used.
# 0 = keep the image's version (the default).
TUBARR_YTDLP_AUTOUPDATE=0
# The container refuses to run as root. Set to 1 only if you really must (not recommended).
# TUBARR_ALLOW_ROOT=0

# ---------------------------------------------------------------- Trimarr (the ad trimmer; starts with Tubarr)
# Nothing to set: Trimarr starts with `docker compose up -d`, stays idle until you switch trimming on in Tubarr
# (Settings -> Trim ads), and links itself to Tubarr with a random token that Tubarr creates on its first start.
# Trimarr's own database, settings and logs. Must be writable by PUID:PGID, like the data folder above.
TRIMARR_DATA_DIR=./trimarr-data
# Tubarr reaches Trimarr at this address (internal Docker network, no published port). Default: http://trimarr:8791.
# Set it to off only if you removed the trimarr service from docker-compose.yml.
# TRIMARR_URL=http://trimarr:8791
# Optional override for advanced setups: your own shared secret instead of the automatic link token (at least 16
# characters; both containers get it from here). Leave it unset to use the automatic token.
# TRIMARR_TOKEN=
# Trimarr doesn't talk to Plex: Tubarr refreshes Plex after a trim.
